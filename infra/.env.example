# PostgreSQL
POSTGRES_USER=ferrobox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ferrobox
POSTGRES_PORT=5432

# Servidor FerroBox (no lo usa docker-compose; arranca el binario con estas variables)
# Días de edad mínima para servir una versión desde un Mirror npm o PyPI.
# 14 reduce la ventana de typosquatting. 0 desactiva la cuarentena. Los Forges no se retienen.
MIRROR_QUARANTINE_DAYS=14

# Garage (almacenamiento compatible con S3)
# Generar con: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32
# Generar con: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=CHANGE_ME_openssl_rand_base64_32
GARAGE_METRICS_TOKEN=CHANGE_ME_openssl_rand_base64_32
