# PostgreSQL
POSTGRES_USER=ferrobox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ferrobox
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Garage (S3-compatible storage)
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32
# Generate with: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=CHANGE_ME_openssl_rand_base64_32
GARAGE_METRICS_TOKEN=CHANGE_ME_openssl_rand_base64_32
# In Docker Compose the node is named `garage`. On the host: 127.0.0.1:3901
GARAGE_RPC_PUBLIC_ADDR=garage:3901

# S3 endpoint and credentials used by FerroBox
S3_ENDPOINT_URL=http://garage:3900
S3_FORCE_PATH_STYLE=true
# Garage requires GK plus 24 hexadecimal characters (12 bytes).
# Generate with: printf 'GK%s\n' "$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_32
S3_BUCKET=ferrobox
S3_REGION=garage

# FerroBox (image + UI)
FERROBOX_PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# UI session expiry (login and SSO), in hours.
SESSION_TTL_HOURS=12
# Optional local OSV index (ferrobox-osv-index v1, JSON or gzip).
# When set, assays use this file instead of https://api.osv.dev.
# An index imported with POST /api/security/osv-feed replaces this file.
# OSV_FEED_PATH=
#
# Connected pull of the same file, published as a Cosign-signed OCI artifact
# (for example ghcr.io/ferrobox/osv-db:2026-10-03). Unset: no pull. An
# air-gapped instance imports that file with curl; it does not use docker save.
# The layer media type is application/vnd.ferrobox.osv-index.v1.
# A missing or invalid signature does not replace the active index.
# OSV_SYNC_REF=
# PEM public key, or its base64 (the publish script prints the base64 line).
# OSV_SYNC_KEY=
# OSV_SYNC_PUBKEY_B64=
# Optional bearer token for a private registry.
# OSV_SYNC_TOKEN=
# Hours between pulls. The first pull runs at startup. Default 24.
# OSV_SYNC_INTERVAL_HOURS=24

# SSO (OIDC). Switch: if OIDC_ISSUER or OIDC_CLIENT_ID is empty,
# FerroBox does not talk to any IdP, does not mount the service, and the UI hides
# the button. Compose Keycloak is optional (`--profile sso`) and does not start
# on its own; you do not need to stop it to turn federated login off.
#   docker compose --profile sso up -d keycloak
#   OIDC_ISSUER=http://127.0.0.1:8080/realms/ferrobox
#   OIDC_CLIENT_ID=ferrobox
#   OIDC_CLIENT_SECRET=ferrobox-dev-secret
# cargo run without FRONTEND_DIR calls {PUBLIC_BASE_URL}/auth/oidc/callback
# (no /api). With Vite, after login (and federated logout) it returns to :3000/login
# unless you set:
#   OIDC_SUCCESS_REDIRECT=http://127.0.0.1:5173/login
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SUCCESS_REDIRECT=
OIDC_SCOPES=
OIDC_ADMIN_ROLES=
OIDC_DEVELOPER_ROLES=
OIDC_READER_ROLES=
OIDC_ROLE_CLAIM=
OIDC_GROUP_CLAIM=
OIDC_AUTO_CREATE_GROUPS=true
