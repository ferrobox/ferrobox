# PostgreSQL
POSTGRES_USER=ferrobox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ferrobox
POSTGRES_PORT=5432

# Garage (almacenamiento compatible con S3)
# Generar con: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32
# Generar con: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=CHANGE_ME_openssl_rand_base64_32
GARAGE_METRICS_TOKEN=CHANGE_ME_openssl_rand_base64_32
# En Docker Compose el nodo se llama `garage`. En host: 127.0.0.1:3901
GARAGE_RPC_PUBLIC_ADDR=garage:3901

# Clave S3 que garage-init importa y que usa FerroBox
S3_ACCESS_KEY_ID=GK1234567890ab
S3_SECRET_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_32
S3_BUCKET=ferrobox
S3_REGION=garage

# FerroBox (imagen + UI)
FERROBOX_PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# SSO (OIDC). Vacío = desactivado. Con Keycloak del compose:
#   docker compose --profile sso up -d keycloak
#   OIDC_ISSUER=http://127.0.0.1:8080/realms/ferrobox
#   OIDC_CLIENT_ID=ferrobox
#   OIDC_CLIENT_SECRET=ferrobox-dev-secret
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SUCCESS_REDIRECT=
OIDC_SCOPES=
OIDC_ADMIN_ROLES=
OIDC_DEVELOPER_ROLES=
OIDC_READER_ROLES=
OIDC_ROLE_CLAIM=
OIDC_GROUP_CLAIM=
OIDC_AUTO_CREATE_GROUPS=true
